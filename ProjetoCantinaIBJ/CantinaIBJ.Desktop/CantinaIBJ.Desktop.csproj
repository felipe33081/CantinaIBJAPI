<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CantinaIBJ</AssemblyName>
    <RootNamespace>CantinaIBJ.Desktop</RootNamespace>
    <!-- Nome amigavel da janela/app -->
    <Product>Cantina IBJ</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Cantina IBJ</Company>
    <!-- Publicacao mais limpa: sem .pdb e sem .xml de referencias ao lado do exe. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Necessario para hospedar o ASP.NET Core (Kestrel) dentro do app WinForms. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CantinaIBJ.WebApi\CantinaIBJ.WebApi.csproj" />
  </ItemGroup>

  <!-- Copia o SPA (build do React) e os appsettings para a saida do app desktop,
       ao lado do .exe, onde AppHost os procura (AppContext.BaseDirectory). -->
  <ItemGroup>
    <Content Include="..\CantinaIBJ.WebApi\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\CantinaIBJ.WebApi\appsettings*.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
